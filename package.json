{
  "name": "oxum-dev-dashboard",
  "version": "0.1.0",
  "description": "One window telling you the state of your front-end projects: dev servers, git, GitHub checks and Claude Code sessions.",
  "author": "Julio Paniagua",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.1.2"
  }
}
